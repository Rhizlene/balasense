#include <Arduino.h>
#include <Wire.h>
#include <SensirionI2CScd4x.h>

SensirionI2CScd4x scd4x;

void setup() {
  Serial.begin(115200);
  Wire.begin(21, 22);
  delay(1000);

  scd4x.begin(Wire);

  scd4x.stopPeriodicMeasurement();
  delay(500);

  uint16_t err = scd4x.startPeriodicMeasurement();
  if (err) {
    Serial.println("Erreur startPeriodicMeasurement !");
    while (1);
  }

  Serial.println("SCD41 OK - mesures toutes les 5s...");
}

void loop() {
  delay(5000);

  uint16_t co2 = 0;
  float temperature = 0.0f;
  float humidity = 0.0f;
  bool dataReady = false;

  scd4x.getDataReadyFlag(dataReady);
  if (!dataReady) {
    Serial.println("Donnees pas pretes...");
    return;
  }

  uint16_t err = scd4x.readMeasurement(co2, temperature, humidity);
  if (err) {
    Serial.println("Erreur lecture !");
    return;
  }

  Serial.println("━━━━━━━━━━━━━━━━━━━━━━━━━━━");
  Serial.print("CO2         : "); Serial.print(co2); Serial.println(" ppm");
  Serial.print("Temperature : "); Serial.print(temperature, 1); Serial.println(" °C");
  Serial.print("Humidite    : "); Serial.print(humidity, 1); Serial.println(" %");
  Serial.println("━━━━━━━━━━━━━━━━━━━━━━━━━━━");
}