/*
 * Test MLX90614 - Capteur température infrarouge
 * Projet BalaSense - Projet personnel
 * 
 * RÉSULTAT VALIDÉ : 34°C mesuré sur peau
 * 
 * Auteur : Rhizlene
 * Date : Janvier 2026
 */
#include <Arduino.h>
#include <Wire.h>
#include <Adafruit_MLX90614.h>

#define I2C_SDA 25
#define I2C_SCL 26

Adafruit_MLX90614 mlx = Adafruit_MLX90614();

void setup() {
  Serial.begin(115200);
  delay(1000);
  
  Serial.println("\n=== BalaSense - MLX90614 Active ===\n");
  
  Wire.begin(I2C_SDA, I2C_SCL);
  
  if (!mlx.begin()) {
    Serial.println("MLX90614 initialization failed");
    while (1);
  }
  
  Serial.println("MLX90614 ready\n");
  delay(2000);
}

void loop() {
  float ambient = mlx.readAmbientTempC();
  float object = mlx.readObjectTempC();
  
  Serial.println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
  Serial.print("Ambient: ");
  Serial.print(ambient, 1);
  Serial.println(" °C");
  
  Serial.print("Object : ");
  Serial.print(object, 1);
  Serial.print(" °C");
  
  if (object > 34.0 && object < 38.0) {
    Serial.print(" | NORMAL");
  } else if (object >= 38.0) {
    Serial.print(" | FEVER");
  }
  
  Serial.println();
  Serial.println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n");
  
  delay(2000);
}