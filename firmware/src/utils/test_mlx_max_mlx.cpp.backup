/*
 * BalaSense - Multi-Capteurs avec Export JSON
 * Étape 2 : Amélioration BPM avec filtrage
 * 
 * Projet personnel - Rhiz - 2026
 */

#include <Arduino.h>
#include <Wire.h>
#include "MAX30105.h"
#include "heartRate.h"
#include <Adafruit_MLX90614.h>
#include "ICM_20948.h"
#include <ArduinoJson.h>

#define I2C_SDA 25
#define I2C_SCL 26

// Instances capteurs
MAX30105 heartSensor;
Adafruit_MLX90614 tempSensor = Adafruit_MLX90614();
ICM_20948_I2C imuSensor;

// Variables MAX30102 - AMÉLIORÉES
const byte RATE_SIZE = 10;  // ← Augmenté de 4 à 10
byte rates[RATE_SIZE];
byte rateSpot = 0;
long lastBeat = 0;
float beatsPerMinute;
int beatAvg;
int validBeatsCount = 0;  // ← Nouveau : compte les battements valides

// Timers pour échantillonnage
unsigned long lastHeartRead = 0;
unsigned long lastTempRead = 0;
unsigned long lastIMURead = 0;
unsigned long lastJSONPrint = 0;

// Intervalles
const unsigned long HEART_INTERVAL = 20;
const unsigned long TEMP_INTERVAL = 1000;
const unsigned long IMU_INTERVAL = 100;
const unsigned long JSON_INTERVAL = 2000;

// Structure de données pour JSON
struct SensorData {
  unsigned long timestamp;
  
  struct {
    int bpm;
    int bpm_avg;
    long ir_value;
    String signal_quality;
    String confidence;  // ← Nouveau : LOW/MEDIUM/HIGH
    int valid_beats;    // ← Nouveau : nombre de battements valides
  } heart;
  
  struct {
    float ambient;
    float object;
  } temperature;
  
  struct {
    struct {
      float x, y, z, total;
    } acceleration;
    
    struct {
      float x, y, z, total;
    } gyroscope;
    
    struct {
      float x, y, z;
    } magnetometer;
    
    float temp;
    bool movement_detected;
    bool rotation_detected;
  } imu;
};

SensorData currentData;

String getSignalQuality(long irValue) {
  if (irValue > 100000) return "excellent";
  if (irValue > 70000) return "good";
  if (irValue > 50000) return "fair";
  return "poor";
}

// ← NOUVELLE FONCTION : Vérifier si BPM est valide
bool isValidBPM(float bpm) {
  return (bpm >= 40 && bpm <= 180);
}

// ← NOUVELLE FONCTION : Calculer la confiance
String getConfidence(int validBeats) {
  if (validBeats >= 8) return "HIGH";
  if (validBeats >= 5) return "MEDIUM";
  if (validBeats >= 2) return "LOW";
  return "NONE";
}

void printJSON() {
  StaticJsonDocument<1024> doc;
  
  doc["timestamp"] = currentData.timestamp;
  
  JsonObject heart = doc.createNestedObject("heart");
  heart["bpm"] = currentData.heart.bpm;
  heart["bpm_avg"] = currentData.heart.bpm_avg;
  heart["ir_value"] = currentData.heart.ir_value;
  heart["signal_quality"] = currentData.heart.signal_quality;
  heart["confidence"] = currentData.heart.confidence;
  heart["valid_beats"] = currentData.heart.valid_beats;
  
  JsonObject temp = doc.createNestedObject("temperature");
  temp["ambient"] = round(currentData.temperature.ambient * 100) / 100.0;
  temp["object"] = round(currentData.temperature.object * 100) / 100.0;
  
  JsonObject imu = doc.createNestedObject("imu");
  
  JsonObject accel = imu.createNestedObject("acceleration");
  accel["x"] = round(currentData.imu.acceleration.x * 100) / 100.0;
  accel["y"] = round(currentData.imu.acceleration.y * 100) / 100.0;
  accel["z"] = round(currentData.imu.acceleration.z * 100) / 100.0;
  accel["total"] = round(currentData.imu.acceleration.total * 100) / 100.0;
  
  JsonObject gyro = imu.createNestedObject("gyroscope");
  gyro["x"] = round(currentData.imu.gyroscope.x * 10) / 10.0;
  gyro["y"] = round(currentData.imu.gyroscope.y * 10) / 10.0;
  gyro["z"] = round(currentData.imu.gyroscope.z * 10) / 10.0;
  gyro["total"] = round(currentData.imu.gyroscope.total * 10) / 10.0;
  
  JsonObject mag = imu.createNestedObject("magnetometer");
  mag["x"] = round(currentData.imu.magnetometer.x);
  mag["y"] = round(currentData.imu.magnetometer.y);
  mag["z"] = round(currentData.imu.magnetometer.z);
  
  imu["temperature"] = round(currentData.imu.temp * 10) / 10.0;
  imu["movement_detected"] = currentData.imu.movement_detected;
  imu["rotation_detected"] = currentData.imu.rotation_detected;
  
  serializeJsonPretty(doc, Serial);
  Serial.println();
}

void printReadable() {
  Serial.println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
  Serial.println("LECTURE MULTI-CAPTEURS");
  Serial.println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n");
  
  Serial.println("--- MAX30102 (Coeur) ---");
  if (currentData.heart.ir_value < 50000) {
    Serial.println("Pas de contact - Posez votre doigt");
  } else {
    Serial.print("Signal IR: ");
    Serial.print(currentData.heart.ir_value);
    Serial.print(" | Qualite: ");
    Serial.println(currentData.heart.signal_quality);
    
    if (currentData.heart.bpm_avg > 0) {
      Serial.print("BPM instantane: ");
      Serial.print(currentData.heart.bpm);
      Serial.print(" | BPM moyen: ");
      Serial.print(currentData.heart.bpm_avg);
      Serial.print(" bpm | Confiance: ");
      Serial.print(currentData.heart.confidence);
      Serial.print(" (");
      Serial.print(currentData.heart.valid_beats);
      Serial.println(" battements)");
    } else {
      Serial.print("En attente de battements (");
      Serial.print(currentData.heart.valid_beats);
      Serial.println(" detectes)");
    }
  }
  
  Serial.println("\n--- MLX90614 (Temperature) ---");
  Serial.print("Ambiante: ");
  Serial.print(currentData.temperature.ambient, 1);
  Serial.println(" C");
  Serial.print("Objet: ");
  Serial.print(currentData.temperature.object, 1);
  Serial.println(" C");
  
  Serial.println("\n--- ICM-20948 (IMU) ---");
  Serial.print("G-force: ");
  Serial.print(currentData.imu.acceleration.total, 2);
  Serial.print(" g");
  if (currentData.imu.movement_detected) {
    Serial.print(" [MOUVEMENT]");
  } else {
    Serial.print(" [STABLE]");
  }
  Serial.println();
  
  Serial.print("Rotation: ");
  Serial.print(currentData.imu.gyroscope.total, 0);
  Serial.print(" deg/s");
  if (currentData.imu.rotation_detected) {
    Serial.println(" [ROTATION]");
  } else {
    Serial.println(" [STABLE]");
  }
  
  Serial.println("\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n");
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  
  Serial.println("\n========================================");
  Serial.println("   BALASENSE - Multi-Capteurs + JSON");
  Serial.println("   Etape 2: Amelioration BPM");
  Serial.println("========================================\n");
  
  Wire.begin(I2C_SDA, I2C_SCL);
  
  Serial.print("MAX30102... ");
  if (!heartSensor.begin(Wire, I2C_SPEED_STANDARD)) {
    Serial.println("ECHEC");
  } else {
    Serial.println("OK");
    heartSensor.setup(30, 4, 2, 100, 411, 4096);
    heartSensor.setPulseAmplitudeRed(0x0A);
    heartSensor.setPulseAmplitudeIR(0x30);
  }
  
  Serial.print("MLX90614... ");
  if (!tempSensor.begin()) {
    Serial.println("ECHEC");
  } else {
    Serial.println("OK");
  }
  
  Serial.print("ICM-20948... ");
  imuSensor.begin(Wire, 0);
  if (imuSensor.status != ICM_20948_Stat_Ok) {
    Serial.println("ECHEC");
  } else {
    Serial.println("OK");
  }
  
  Serial.println("\n========================================");
  Serial.println("Ameliorations BPM:");
  Serial.println("- Moyenne sur 10 battements (vs 4)");
  Serial.println("- Filtrage: 40-180 BPM valides");
  Serial.println("- Confiance: LOW/MEDIUM/HIGH");
  Serial.println("- Stabilisation en 10-15 secondes");
  Serial.println("========================================\n");
  
  delay(2000);
}

void loop() {
  unsigned long currentMillis = millis();
  
  // ========== LECTURE MAX30102 (50 Hz) - AMÉLIORÉE ==========
  if (currentMillis - lastHeartRead >= HEART_INTERVAL) {
    lastHeartRead = currentMillis;
    
    long irValue = heartSensor.getIR();
    currentData.heart.ir_value = irValue;
    currentData.heart.signal_quality = getSignalQuality(irValue);
    
    if (irValue >= 50000 && irValue < 260000) {
      if (checkForBeat(irValue) == true) {
        long delta = millis() - lastBeat;
        lastBeat = millis();
        beatsPerMinute = 60 / (delta / 1000.0);
        
        // ← NOUVEAU : Filtrage des valeurs aberrantes
        if (isValidBPM(beatsPerMinute)) {
          rates[rateSpot++] = (byte)beatsPerMinute;
          rateSpot %= RATE_SIZE;
          
          // Compter les battements valides
          if (validBeatsCount < RATE_SIZE) {
            validBeatsCount++;
          }
          
          // Calculer la moyenne uniquement sur les battements valides
          beatAvg = 0;
          int count = 0;
          for (byte x = 0; x < RATE_SIZE; x++) {
            if (rates[x] > 0) {  // Uniquement les slots remplis
              beatAvg += rates[x];
              count++;
            }
          }
          if (count > 0) {
            beatAvg /= count;
          }
        }
      }
      currentData.heart.bpm = (int)beatsPerMinute;
      currentData.heart.bpm_avg = beatAvg;
      currentData.heart.valid_beats = validBeatsCount;
      currentData.heart.confidence = getConfidence(validBeatsCount);
    } else {
      currentData.heart.bpm = 0;
      currentData.heart.bpm_avg = 0;
      currentData.heart.valid_beats = 0;
      currentData.heart.confidence = "NONE";
      beatAvg = 0;
      validBeatsCount = 0;
      // Reset du buffer
      for (byte x = 0; x < RATE_SIZE; x++) {
        rates[x] = 0;
      }
    }
  }
  
  // ========== LECTURE MLX90614 (1 Hz) ==========
  if (currentMillis - lastTempRead >= TEMP_INTERVAL) {
    lastTempRead = currentMillis;
    
    currentData.temperature.ambient = tempSensor.readAmbientTempC();
    currentData.temperature.object = tempSensor.readObjectTempC();
  }
  
  // ========== LECTURE ICM-20948 (10 Hz) ==========
  if (currentMillis - lastIMURead >= IMU_INTERVAL) {
    lastIMURead = currentMillis;
    
    if (imuSensor.dataReady()) {
      imuSensor.getAGMT();
      
      currentData.imu.acceleration.x = imuSensor.accX() / 1000.0;
      currentData.imu.acceleration.y = imuSensor.accY() / 1000.0;
      currentData.imu.acceleration.z = imuSensor.accZ() / 1000.0;
      currentData.imu.acceleration.total = sqrt(
        pow(currentData.imu.acceleration.x, 2) +
        pow(currentData.imu.acceleration.y, 2) +
        pow(currentData.imu.acceleration.z, 2)
      );
      
      currentData.imu.gyroscope.x = imuSensor.gyrX();
      currentData.imu.gyroscope.y = imuSensor.gyrY();
      currentData.imu.gyroscope.z = imuSensor.gyrZ();
      currentData.imu.gyroscope.total = sqrt(
        pow(currentData.imu.gyroscope.x, 2) +
        pow(currentData.imu.gyroscope.y, 2) +
        pow(currentData.imu.gyroscope.z, 2)
      );
      
      currentData.imu.magnetometer.x = imuSensor.magX();
      currentData.imu.magnetometer.y = imuSensor.magY();
      currentData.imu.magnetometer.z = imuSensor.magZ();
      
      currentData.imu.temp = imuSensor.temp();
      
      currentData.imu.movement_detected = (currentData.imu.acceleration.total > 1.5);
      currentData.imu.rotation_detected = (currentData.imu.gyroscope.total > 50);
    }
  }
  
  // ========== AFFICHAGE JSON (toutes les 2s) ==========
  if (currentMillis - lastJSONPrint >= JSON_INTERVAL) {
    lastJSONPrint = currentMillis;
    currentData.timestamp = currentMillis;
    
    printReadable();
    Serial.println("JSON:");
    printJSON();
    Serial.println("\n");
  }
  
  delay(10);
}